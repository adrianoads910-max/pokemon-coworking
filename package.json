{
  "name": "pokemon-coworking",
  "version": "0.3.1",
  "description": "A Pokémon-themed pixel office for your AI coding agents: every repository is a climate zone, every Claude Code / Codex session a Pokémon that levels up and evolves as it works.",
  "bin": {
    "coworking-agents": "bin/coworking-agents.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    ".claude-plugin",
    "README.md",
    "LICENSE",
    "commands",
    "skills",
    "AGENTS.md",
    "ROADMAP.md",
    "docs/*.png"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/coworking-agents.js --pokemon",
    "classic": "node bin/coworking-agents.js",
    "demo": "node bin/coworking-agents.js --demo",
    "test": "node test/run.js",
    "screenshots": "bash scripts/screenshots.sh",
    "video": "node scripts/record-video.js"
  },
  "keywords": [
    "pokemon",
    "pokeapi",
    "ai",
    "agents",
    "claude-code",
    "codex",
    "coworking",
    "dashboard",
    "pixel-art",
    "monitor"
  ],
  "author": "Adriano",
  "contributors": ["Lucas Chacon (original coworking-agents)"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianoads910-max/pokemon-coworking.git"
  },
  "homepage": "https://github.com/adrianoads910-max/pokemon-coworking#readme",
  "bugs": "https://github.com/adrianoads910-max/pokemon-coworking/issues",
  "license": "MIT"
}
